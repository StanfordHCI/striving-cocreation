#!/usr/bin/env bash
# Pre-commit hook: secret detection + test suite
# Install: cp scripts/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit

set -euo pipefail

ROOT_DIR="$(git rev-parse --show-toplevel)"

# ── Secret detection ─────────────────────────────────────────────────────
echo "Checking for leaked secrets..."

SECRET_PATTERNS=(
    'AIzaSy[a-zA-Z0-9_-]{33}'           # Google API key
    'sk-ant-api[a-zA-Z0-9_-]+'          # Anthropic API key
    'sk-[a-zA-Z0-9]{48,}'               # OpenAI API key
    'AKIA[0-9A-Z]{16}'                   # AWS access key
    '-----BEGIN PRIVATE KEY-----'        # Private key PEM
    '-----BEGIN RSA PRIVATE KEY-----'    # RSA private key PEM
)

PATTERN=$(IFS='|'; echo "${SECRET_PATTERNS[*]}")

LEAKED_FILES=$(git diff --cached --diff-filter=ACM -z --name-only | \
    xargs -0 grep -lE "$PATTERN" 2>/dev/null | \
    grep -v 'scripts/pre-commit' | \
    grep -v '.gitignore' || true)

if [ -n "$LEAKED_FILES" ]; then
    echo ""
    echo "BLOCKED: Potential secrets found in staged files:"
    echo "$LEAKED_FILES" | while read -r f; do
        echo "  - $f"
    done
    echo ""
    echo "Remove secrets before committing, or use 'git commit --no-verify' to skip."
    exit 1
fi

echo "No secrets detected."

# ── Test suite ───────────────────────────────────────────────────────────
echo "Running tests..."

if [ -d "${ROOT_DIR}/.venv" ]; then
    PYTHON="${ROOT_DIR}/.venv/bin/python"
else
    PYTHON="python3"
fi

if ! "$PYTHON" -m pytest tests/ -q --tb=line 2>&1; then
    echo ""
    echo "BLOCKED: Tests failed. Fix before committing."
    exit 1
fi

echo "All checks passed."
