{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "strict": true,
    "allowJs": false,
    "checkJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "outDir": "./dist-main",
    "forceConsistentCasingInFileNames": true,
    "ignoreDeprecations": "6.0",
    "types": ["node"]
  },
  "include": [
    "main.ts",
    "preload.ts",
    "ipc-handlers.ts",
    "app-exclusion.ts",
    "backend-api.ts",
    "url-exclusion.ts",
    "shared/ipc.ts",
    "shared/wave-mark.ts"
  ]
}
