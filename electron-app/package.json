{
  "name": "tempo-electron",
  "version": "0.1.0",
  "description": "Tempo - Behavioral Pattern Observer Electron App",
  "main": "dist-main/main.js",
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && tsc -p tsconfig.node.json && electron .\"",
    "dev:vite": "vite",
    "build": "vite build",
    "build:python-ui": "TEMPO_BUILD_TARGET=python vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "build:main": "tsc -p tsconfig.node.json",
    "build:electron": "electron-builder",
    "preview": "vite preview",
    "start": "tsc -p tsconfig.node.json && electron ."
  },
  "keywords": [
    "tempo",
    "electron",
    "behavioral-patterns"
  ],
  "author": "Omar Shaikh",
  "license": "MIT",
  "engines": {
    "node": ">=22.13 <25"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.14.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.5.0",
    "concurrently": "^8.2.2",
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3",
    "postcss": "^8.5.14",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3",
    "vite": "^5.4.21",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.tempo.app",
    "productName": "Tempo",
    "directories": {
      "output": "dist"
    },
    "files": [
      "dist/**/*",
      "dist-main/**/*",
      "index.html",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../resources/python-server",
        "to": "python-server",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    }
  },
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621"
}
