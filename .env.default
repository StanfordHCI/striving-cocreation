# Copy this file to .env and configure exactly one provider below.
# .env is ignored by Git; never commit API keys or service-account files.

# --- Gemini API (default) ---
MODEL_NAME="gemini-3.8-flash"
# GOOGLE_API_KEY="your-google-api-key"

# --- Vertex AI Express Mode via API key (alternative) ---
# MODEL_NAME="gemini-3.8-flash"
# GEMINI_VERTEXAI_EXPRESS=true
# VERTEX_EXPRESS_API_KEY="your-vertex-express-api-key"

# --- OpenAI (alternative) ---
# MODEL_NAME="gpt-4o-mini"
# OPENAI_API_KEY="your-openai-api-key"

# --- Anthropic Claude (alternative) ---
# MODEL_NAME="claude-sonnet-4-5"
# ANTHROPIC_API_KEY="your-anthropic-api-key"
# ANTHROPIC_API_BASE="https://api.anthropic.com"  # Optional main-pipeline override.

# --- OpenAI-compatible endpoint (alternative; local or hosted) ---
# MODEL_NAME="Qwen/Qwen2-VL-7B-Instruct"
# TEMPO_LM_API_BASE="http://localhost:8000/v1"
# TEMPO_LM_API_KEY="your-endpoint-key"  # Omit if the endpoint needs no key.

# --- Standard Vertex AI via service account / ADC (alternative) ---
# MODEL_NAME="gemini-3.8-flash"
# GEMINI_VERTEXAI=true
# GOOGLE_APPLICATION_CREDENTIALS="/absolute/path/to/service-account.json"
# GOOGLE_CLOUD_PROJECT="your-gcp-project-id"
# GOOGLE_CLOUD_LOCATION="global"

# TEMPO_DEBUG=true
